# Porta da API (a interface em desenvolvimento usa 5173 e faz proxy para esta porta)
PORT=3001

# Diretório de dados locais (relativo à raiz do repositório; API e worker partilham-no) (base de dados, ficheiros gerados). Fica fora do controlo de versões.
REPLICA_STORAGE_DIR=./storage

# Geração de roteiros com LLM local gratuito (opcional). Sem isto, só o "Esqueleto" fica disponível.
# OLLAMA_MODEL=llama3.2
# OLLAMA_URL=http://127.0.0.1:11434
